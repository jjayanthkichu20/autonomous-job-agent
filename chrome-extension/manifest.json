{
  "manifest_version": 3,
  "name": "Arya AI Job Hunter — ATS Auto-Apply & Copilot",
  "version": "1.2.0",
  "description": "Autonomous AI job application co-pilot (Atom-style): ATS match scoring, smart screening question answering, fact-grounded cover letters, and 1-click auto-apply on LinkedIn, Greenhouse, Lever, Workday & Indeed.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arya AI Job Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
